[
  {
    "extension": "tables",
    "example": 1,
    "markdown": "| foo | bar |\n| --- | --- |\n| baz | bim |\n",
    "html": "<table>\n<thead>\n<tr>\n<th>foo</th>\n<th>bar</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>baz</td>\n<td>bim</td>\n</tr>\n</tbody>\n</table>\n"
  },
  {
    "extension": "task_lists",
    "example": 2,
    "markdown": "- [ ] foo\n- [x] bar\n",
    "html": "<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> foo</li>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> bar</li>\n</ul>\n"
  },
  {
    "extension": "strikethrough",
    "example": 3,
    "markdown": "~~Hi~~ Hello, world!\n",
    "html": "<p><del>Hi</del> Hello, world!</p>\n"
  },
  {
    "extension": "autolinks",
    "example": 4,
    "markdown": "Visit https://example.com for info.\n",
    "html": "<p>Visit <a href=\"https://example.com\" rel=\"nofollow noopener noreferrer\">https://example.com</a> for info.</p>\n"
  },
  {
    "extension": "footnotes",
    "example": 5,
    "markdown": "Here is a note[^1].\n\n[^1]: Footnote content.\n",
    "html_contains": [
      "<sup class=\"footnote-ref\"><a href=\"#fn-1\" id=\"fnref-1\" data-footnote-ref>1</a></sup>",
      "<section class=\"footnotes\" data-footnotes>",
      "<li id=\"fn-1\">"
    ]
  }
]
